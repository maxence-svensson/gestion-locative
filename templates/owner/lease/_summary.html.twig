<section class="card">
    <div class="card__header">
        <h2>Bail en cours</h2>
        <span class="badge">Depuis le {{ lease.startDate|long_date }}</span>
    </div>

    <dl class="details details--flat">
        <div>
            <dt>Loyer hors charges</dt>
            <dd>{{ lease.rent|money }}</dd>
        </div>
        <div>
            <dt>Provision sur charges</dt>
            <dd>{{ lease.charges|money }}</dd>
        </div>
        <div>
            <dt>Total mensuel</dt>
            <dd><strong>{{ lease.monthlyTotal|money }}</strong></dd>
        </div>
        <div>
            <dt>Payable le</dt>
            <dd>{{ lease.paymentDay == 1 ? '1er' : lease.paymentDay }} de chaque mois</dd>
        </div>
        <div>
            <dt>Dépôt de garantie</dt>
            <dd>{{ lease.deposit|money }}</dd>
        </div>
        <div>
            <dt>IRL de référence</dt>
            <dd>{{ lease.irlReferenceQuarter == 1 ? '1er' : lease.irlReferenceQuarter ~ 'e' }} trimestre {{ lease.irlReferenceYear }}</dd>
        </div>
    </dl>

    <h3 class="card__subtitle">{{ lease.tenants|length > 1 ? 'Locataires (colocation)' : 'Locataire' }}</h3>
    <ul class="tenant-summary">
        {% for tenant in lease.tenants %}
            <li>
                <div>
                    <strong>{{ tenant.fullName }}</strong> <span class="tenant-summary__email">{{ tenant.email }}</span>
                </div>
                <div class="tenant-summary__access">
                    {% if tenant.hasAccount() %}
                        <span class="pill pill--success">Espace activé</span>
                    {% else %}
                        {% if tenant.isInvitationPending(today) %}
                            <span class="pill">Invité le {{ tenant.invitedAt|long_date }}</span>
                        {% elseif tenant.hasInvitationExpired(today) %}
                            <span class="pill pill--warning">Invitation expirée</span>
                        {% endif %}
                        <form method="post" action="{{ path('owner_tenant_invite', {id: tenant.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('invite-tenant') }}">
                            <button type="submit" class="button button--ghost button--small">
                                {{ tenant.invitedAt ? 'Renvoyer l\'invitation' : 'Inviter dans son espace' }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ul>

    <h3 class="card__subtitle">Échéances</h3>
    <p class="card__note">Loyers suivis depuis {{ lease.rentTrackedFrom|month_year }}.</p>
    {% if dues is empty %}
        <p class="card__note">La première échéance sera créée au début du suivi.</p>
    {% else %}
        {{ include('rent_due/_table.html.twig', {receipt_route: 'owner_rent_due_receipt', can_record_payment: true}) }}
    {% endif %}
</section>
