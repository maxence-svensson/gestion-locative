{% extends 'layout/app.html.twig' %}

{% block title %}Espace propriétaire · Gestion locative{% endblock %}

{% block content %}
    <h1>Bonjour {{ app.user.firstName }}</h1>

    {% if property_count == 0 %}
        <section class="empty-state">
            <h2>Aucun bien pour l'instant</h2>
            <p>Vos logements, vos baux et le suivi de vos loyers apparaîtront ici dès que vous aurez ajouté votre premier bien.</p>
            <a href="{{ path('owner_property_new') }}" class="button button--primary">Ajouter un bien</a>
        </section>
    {% else %}
        <div class="stat-grid">
            <section class="stat-card">
                <p class="stat-card__value">{{ property_count }}</p>
                <p class="stat-card__label">{{ property_count > 1 ? 'biens en gestion' : 'bien en gestion' }}</p>
                <a href="{{ path('owner_property_index') }}">Voir mes biens</a>
            </section>
            <section class="stat-card">
                <p class="stat-card__value">{{ due_this_month|money }}</p>
                <p class="stat-card__label">appelés en {{ current_month|month_year }}</p>
            </section>
            <section class="stat-card">
                <p class="stat-card__value">{{ received_this_month|money }}</p>
                <p class="stat-card__label">encaissés en {{ current_month|month_year }}</p>
            </section>
            <section class="stat-card{% if overdue_count > 0 %} stat-card--alert{% endif %}">
                <p class="stat-card__value">{{ overdue_count }}</p>
                <p class="stat-card__label">{{ overdue_count > 1 ? 'échéances en retard' : 'échéance en retard' }}</p>
            </section>
        </div>
    {% endif %}
{% endblock %}
