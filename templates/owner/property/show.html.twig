{% extends 'layout/app.html.twig' %}

{% block title %}{{ property.name }} · Gestion locative{% endblock %}

{% block content %}
    <a href="{{ path('owner_property_index') }}" class="back-link">← Mes biens</a>

    <div class="page-header">
        <h1>{{ property.name }}</h1>
        <div class="page-header__actions">
            <a href="{{ path('owner_property_edit', {id: property.id}) }}" class="button button--ghost">Modifier</a>
            {# Un bien loué ne peut pas être supprimé : le bouton n'est proposé que pour un bien vacant #}
            {% if not lease %}
                <form method="post" action="{{ path('owner_property_delete', {id: property.id}) }}"
                      data-turbo-confirm="Supprimer « {{ property.name }} » ? Cette action est définitive.">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-property') }}">
                    <button type="submit" class="button button--danger">Supprimer</button>
                </form>
            {% endif %}
        </div>
    </div>

    {% if property.energyClass.freezesRent %}
        <div class="alert alert--warning" role="note">
            Ce logement est classé {{ property.energyClass.value }} au DPE : son loyer ne peut plus augmenter,
            ni à la révision annuelle, ni au changement de locataire, tant que des travaux ne l'ont pas fait changer de classe.
        </div>
    {% endif %}

    <dl class="details">
        <div>
            <dt>Adresse</dt>
            <dd>{{ property.fullAddress }}</dd>
        </div>
        <div>
            <dt>Type</dt>
            <dd>{{ property.housingType.label }} {{ property.furnished ? 'meublé' : 'vide' }}</dd>
        </div>
        <div>
            <dt>Surface habitable</dt>
            <dd>{{ property.surface|format_number(locale: 'fr') }} m²</dd>
        </div>
        <div>
            <dt>Classe énergie</dt>
            <dd>{{ include('owner/property/_energy_class.html.twig', {energy_class: property.energyClass}) }}</dd>
        </div>
    </dl>

    {% if lease %}
        {{ include('owner/lease/_summary.html.twig') }}
    {% else %}
        <section class="empty-state">
            <h2>Ce bien est vacant</h2>
            <p>Créez le bail pour suivre les loyers de ce logement et donner à vos locataires l'accès à leur espace.</p>
            <a href="{{ path('owner_lease_new', {id: property.id}) }}" class="button button--primary">Créer le bail</a>
        </section>
    {% endif %}
{% endblock %}
