{% extends 'base.html.twig' %}

{# Mise en page commune aux espaces propriétaire et locataire #}
{% block body %}
    {% set in_owner_space = app.current_route starts with 'owner_' %}

    <header class="topbar">
        <div class="container topbar__inner">
            <a href="{{ path('app_dashboard') }}" class="topbar__brand">Gestion locative</a>

            {% if in_owner_space %}
                <nav class="topbar__nav" aria-label="Espace propriétaire">
                    <a href="{{ path('owner_dashboard') }}"
                       {% if app.current_route == 'owner_dashboard' %}aria-current="page"{% endif %}>Tableau de bord</a>
                    <a href="{{ path('owner_property_index') }}"
                       {% if app.current_route starts with 'owner_property_' or app.current_route starts with 'owner_lease_' or app.current_route starts with 'owner_rent_due_' %}aria-current="page"{% endif %}>Mes biens</a>
                </nav>
            {% endif %}

            <div class="topbar__user">
                {% if is_granted('ROLE_OWNER') and is_granted('ROLE_TENANT') %}
                    <nav class="topbar__switch" aria-label="Changer d'espace">
                        <a href="{{ path('owner_dashboard') }}"
                           {% if in_owner_space %}aria-current="page"{% endif %}>Propriétaire</a>
                        <a href="{{ path('tenant_dashboard') }}"
                           {% if app.current_route starts with 'tenant_' %}aria-current="page"{% endif %}>Locataire</a>
                    </nav>
                {% endif %}
                <span>{{ app.user.fullName }}</span>
                <a href="{{ path('app_logout') }}" class="button button--ghost">Se déconnecter</a>
            </div>
        </div>
    </header>

    <main class="container app-main">
        {% for type, messages in app.flashes(['success', 'warning']) %}
            {% for message in messages %}
                <div class="alert alert--{{ type }}" role="status">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </main>
{% endblock %}
